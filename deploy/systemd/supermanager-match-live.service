[Unit]
Description=Supermanager push and fantasy scores when a club game finishes
After=network.target supermanager.service

[Service]
Type=oneshot
User=ebernat
Group=ebernat
WorkingDirectory=/home/ebernat/supermanager
EnvironmentFile=/etc/supermanager.env
Environment=PATH=/home/ebernat/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=APP_URL=http://127.0.0.1:4317
Environment=DATA_DIR=/home/ebernat/supermanager/data
Environment=HOME=/home/ebernat
Environment=FCBQ_CHROME_PROFILE=/home/ebernat/.cache/fcbq-chrome
Environment=FCBQ_CDP_PORT=9335
ExecStart=/home/ebernat/.nvm/versions/node/v22.23.3/bin/node /home/ebernat/supermanager/scripts/match-live.mjs --fetch
TimeoutStartSec=900
