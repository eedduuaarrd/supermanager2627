[Unit]
Description=Supermanager Balaguer weekend sync (stats, fixtures, score, tip-off lock)
After=network-online.target supermanager.service
Wants=network-online.target

[Service]
Type=oneshot
User=ebernat
Group=ebernat
WorkingDirectory=/home/ebernat/supermanager
EnvironmentFile=/etc/supermanager.env
Environment=PATH=/home/ebernat/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=APP_URL=http://127.0.0.1:4317
Environment=DATA_DIR=/home/ebernat/supermanager/data
Environment=WEEKEND_SYNC_LOG=/var/log/supermanager-weekend-sync.log
ExecStart=/home/ebernat/.nvm/versions/node/v22.23.3/bin/node /home/ebernat/supermanager/scripts/weekend-sync.mjs
Nice=10
